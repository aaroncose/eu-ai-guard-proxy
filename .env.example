HOST=0.0.0.0
PORT=8000
DEBUG=False

# Origenes autorizados para CORS, separados por comas. Vacio deja CORS apagado
CORS_ALLOW_ORIGINS=
# URL publica del proxy, usada por el dashboard para pedir el expediente
PROXY_PUBLIC_URL=http://localhost:8000

UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=tu-api-key-de-openai-aqui
UPSTREAM_TIMEOUT=60.0

DATABASE_URL=sqlite+aiosqlite:///./data/audit_ledger.db
PROXY_API_KEY=sk-guard-local-dev-key

# Auditoria
AUDIT_WRITE_MAX_ATTEMPTS=3
AUDIT_DRAIN_TIMEOUT=10.0
AUDIT_EXPORT_MAX_RECORDS=50000
AUDIT_PAGE_SIZE=1000

S3_ENABLED=False
S3_ENDPOINT_URL=
S3_BUCKET_NAME=ai-audit-ledger-eu
S3_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RETENTION_DAYS=180
# Dias que revisa el arranque en busca de lotes sin sellar
ARCHIVE_BACKFILL_DAYS=30

# Sello de tiempo RFC 3161. DigiCert queda fuera de la lista de confianza
# europea, asi que para un sello cualificado hay que apuntar a un QTSP
EIDAS_TSA_URL=https://timestamp.digicert.com

# Cifra la clave privada de firma en disco. Cambiala en produccion
SIGNING_KEY_PASSPHRASE=dev-insecure-signing-passphrase
